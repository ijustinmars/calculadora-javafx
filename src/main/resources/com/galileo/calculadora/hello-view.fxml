<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox alignment="CENTER" prefHeight="277.0" prefWidth="290.0" spacing="20.0" xmlns:fx="http://javafx.com/fxml/1" xmlns="http://javafx.com/javafx/17.0.12" fx:controller="com.galileo.calculadora.HelloController">
    <padding>
        <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
    </padding>
   <TextField fx:id="txtOperador1" text="Operador1" />
   <ComboBox fx:id="cmbOpciones" prefWidth="150.0" promptText="Opciones" />
   <TextField fx:id="txtOperador2" text="Operador2" />
   <Label fx:id="lblResultado" prefHeight="55.0" prefWidth="253.0" text="0.00" />

    <Label fx:id="welcomeText" />
    <Button fx:id="btnCalcular" onAction="#calcular" text="Calcular" />
</VBox>
